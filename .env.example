# Chép tệp này thành .env (cùng thư mục với docker-compose.yml) rồi điền giá trị. .env không lên git.

# Mật khẩu PostgreSQL. Chỉ dùng chữ, số, - và _ (mật khẩu nằm trong URL kết nối). Ví dụ tạo ngẫu nhiên:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Tuỳ chọn: khoá ký token đăng nhập, ít nhất 32 ký tự. Bỏ trống thì API tự sinh vào volume diacare-data.
DIACARE_API_SECRET=

# Tuỳ chọn: số lượt tư vấn chạy cùng lúc (mặc định 4); quá thì chờ tối đa 120 giây rồi trả 503.
# DIACARE_CHAT_CONCURRENCY=4
